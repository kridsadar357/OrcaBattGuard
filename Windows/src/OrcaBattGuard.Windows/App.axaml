<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OrcaBattGuard.Windows.App"
             RequestedThemeVariant="Dark"
             Name="Orca Battery Guardian">
    <Application.Resources>
        <FontFamily x:Key="SarabunFont">avares://OrcaBattGuard/assets/fonts#Sarabun</FontFamily>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0F10" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181B1D" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#222629" />
        <SolidColorBrush x:Key="AccentBrush" Color="#48D7B5" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F4F4" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A7AA" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SarabunFont}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="#3A4043" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="{StaticResource SarabunFont}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource SarabunFont}" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/assets/orca.ico" ToolTipText="Orca Battery Guardian" Clicked="ShowWindow_OnClick">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Dashboard" Click="ShowWindow_OnClick" />
                        <NativeMenuItem Header="Refresh" Click="Refresh_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="Quit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
