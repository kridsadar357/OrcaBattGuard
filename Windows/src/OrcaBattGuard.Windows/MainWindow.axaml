<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OrcaBattGuard.Windows.MainWindow"
        Title="Orca Battery Guardian" Width="520" Height="780"
        MinWidth="480" MinHeight="620" WindowStartupLocation="CenterScreen"
        Icon="/assets/orca.ico" Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Grid Grid.Row="0" Margin="0,0,0,20" ColumnDefinitions="76,*,Auto">
                <Border Width="62" Height="62" CornerRadius="31" Background="{StaticResource SurfaceBrush}">
                    <Image Source="/assets/orca-mascot.png" Margin="5" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Orca" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Battery Guardian for Windows" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                    <CheckBox Content="Protection" IsChecked="{Binding ProtectionEnabled}"
                              Foreground="{StaticResource PrimaryTextBrush}" />
                    <CheckBox Content="Simulation" IsChecked="{Binding SimulationEnabled}"
                              Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,18">
                <Grid ColumnDefinitions="110,*">
                    <Grid Width="92" Height="92">
                        <Ellipse Stroke="#303537" StrokeThickness="8" />
                        <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="8" Margin="8" />
                        <TextBlock Text="{Binding PercentageText}" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,9" />
                        <TextBlock Text="{Binding TelemetryText}" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Charge profile" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RangeText}" Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                </DockPanel>
                <UniformGrid Columns="3">
                    <Button Content="Max Life 50-70" Command="{Binding SetMaxLifeCommand}" Margin="0,0,8,0" />
                    <Button Content="Balanced 50-80" Command="{Binding SetBalancedCommand}" Margin="0,0,8,0" />
                    <Button Content="Travel 50-100" Command="{Binding SetTravelCommand}" />
                </UniformGrid>
                <Grid Margin="0,14,0,0" ColumnDefinitions="*,18,*">
                    <StackPanel>
                        <TextBlock Text="Resume charging" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Slider Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding LowerLimit}" />
                        <TextBlock Text="{Binding LowerText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stop charging" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Slider Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding UpperLimit}" />
                        <TextBlock Text="{Binding UpperText}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Charge controller" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ControllerState}" HorizontalAlignment="Right"
                                   Foreground="{StaticResource AccentBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ControllerMessage}" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding ManufacturerText}" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Refreshes every 30 seconds" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>

            <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="14" Margin="0,16,0,0" MaxHeight="150">
                <StackPanel>
                    <TextBlock Text="Recent activity" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="105">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="62,*,Auto" Margin="0,3">
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Width="170"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
